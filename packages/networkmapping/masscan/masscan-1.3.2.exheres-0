require github [ user="robertdavidgraham" pn="masscan" ] 
SUMMARY="fast tcp/udp port scanner"
SLOT="0"
PLATFORMS="~amd64"
MYOPTIONS=""
DEPENDENCIES=""

src_compile() {
    emake CC="${CC}"
}
DEFAULT_SRC_INSTALL_PARAMS=( /usr/$(exhost --target) )
src_install() {
    dobin bin/masscan
}
