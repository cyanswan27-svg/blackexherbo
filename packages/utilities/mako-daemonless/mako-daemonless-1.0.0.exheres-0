require github [ user="pakhromov" pn="mako-daemonless" tag="v${PV}" ] meson 
SUMMARY="daemonless notifications"
SLOT="0"
PLATFORMS="~amd64"
MYOPTIONS=""
DEPENDENCIES="
    build:
        sys-libs/wayland-protocols
        virtual/pkg-config
    build+run:
        sys-libs/wayland
        x11-libs/cairo
        x11-libs/pango
        dev-libs/glib:2
        sys-apps/systemd
"
MESON_SRC_CONFIGURE_PARAMS=(
        -Dsd-bus-provider=libsystemd
)

