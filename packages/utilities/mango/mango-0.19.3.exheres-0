require github [ user='mangowm' ] meson

SUMMARY="Wayland compositor based on dwl and scenefx"
HOMEPAGE="https://github.com"

LICENCES="GPL-3"
SLOT="0"
PLATFORMS="~amd64"
MYOPTIONS=""

DEPENDENCIES="
    build:
        sys-libs/wayland-protocols
        virtual/pkg-config
    build+run:
        dev-libs/cjson
        dev-libs/pcre2
        dev-libs/scenefx
        sys-libs/libinput
        sys-libs/wayland
        sys-libs/wlroots
        x11-dri/libdrm
        x11-libs/libxkbcommon
        x11-libs/pango
        x11-libs/pixman
"

MESON_SRC_CONFIGURE_PARAMS=(
    -Db_ndebug=true
    -Dxwayland=disabled
)

src_install() {
    meson_src_install
    edo rm -rf "${IMAGE}/usr/lib"
}


