require github [ user="jarun" pn="nnn" tag="v${PV}" ]
SUMMARY="lightweight file manager written in C"
SLOT="0"
PLATFORMS="~amd64"
MYOPTIONS=""
DEPENDENCIES="
    build:
        virtual/pkg-config
    build+run:
        sys-libs/ncurses
        sys-libs/readline
"
src_compile() {
    emake -j4
}
src_install() {
    dobin nnn
}
