require cargo github [ user="linuxmobile" pn="oxicord" tag="v${PV}" ]

SUMMARY="Terminal-based Discord client written in Rust"
HOMEPAGE="https://github.com"

LICENCES="GPL-3"
SLOT="0"
PLATFORMS="~amd64"
MYOPTIONS=""

DEPENDENCIES="
    build:
        dev-lang/rust
        virtual/pkg-config
    build+run:
        dev-libs/glib:2
        sys-apps/dbus
"

src_prepare() {
    default
    cargo generate-lockfile --offline
}


