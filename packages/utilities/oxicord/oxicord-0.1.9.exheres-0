require cargo github [ user="linuxmobile" pn="oxicord" tag="v${PV}" ] 
SUMMARY="Terminal based discord client"
SLOT="0"
PLATFORMS="~amd64"
MYOPTIONS=""
DEPENDENCIES="
    build:
        dev-lang/rust
        virtual/pkg-config
    build+run:
        sys-apps/dbus
        dev-libs/glib:2
"
src_prepare() {
    default
    sed -i 's/"chafa-dyn",\?//g' Cargo.toml
    cargo generate-lockfile --offline
}
src_compile() {
    cargo_src_compile
}
src_install() {
    cargo_src_install
}
