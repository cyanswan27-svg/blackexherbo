require github [ user="atx" pn="wtype" tag="v${PV}" ] meson

SUMMARY="xdotool type for Wayland"
HOMEPAGE="https://github.com/atx/wtype"

LICENCES="MIT"
SLOT="0"
PLATFORMS="~amd64"
MYOPTIONS=""

DEPENDENCIES="
    build:
        sys-libs/wayland-protocols
        virtual/pkg-config
    build+run:
        sys-libs/wayland
        x11-libs/libxkbcommon
"

